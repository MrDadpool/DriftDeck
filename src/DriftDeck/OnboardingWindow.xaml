<Window x:Class="DriftDeck.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to DriftDeck" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource SurfaceBaseBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="StepLabel" Style="{StaticResource GroupLabel}"
                       Foreground="{StaticResource AccentBrush}" Text="STEP 1 OF 3" />
            <TextBlock x:Name="TitleText" Margin="0,8,0,0" FontSize="{StaticResource TextXl}" FontWeight="Bold"
                       Text="DriftDeck is a workspace that floats over anything" />
        </StackPanel>

        <!-- One panel per step. Only the current one is visible; the window resizes to fit. -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <StackPanel x:Name="StepOne">
                <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="{StaticResource TextSm}"
                           Text="Browser and notes panels sit above your game or application as ordinary always-on-top desktop windows. Drag them anywhere across every monitor, fade them until they are barely there, and leave them running." />
                <Border Margin="0,16,0,0" Padding="16,14" Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel>
                        <TextBlock Text="SAFETY BOUNDARY" Style="{StaticResource GroupLabel}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="19"
                                   FontSize="{StaticResource TextSm}"
                                   Text="DriftDeck never reads game memory or files, injects code, hooks rendering, automates input, or talks to anti-cheat software. It only knows which window is in front, the same thing your taskbar knows." />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="{StaticResource TextSm}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Run your game in borderless-windowed mode. Exclusive fullscreen can stop any desktop overlay from appearing." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="StepTwo" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="{StaticResource TextSm}"
                           Text="Two shortcuts work everywhere, including inside a game. They are the whole reason the overlay stays out of your way." />

                <Border Margin="0,16,0,0" Padding="16,13" Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Padding="7,2" Background="{StaticResource AccentPillBrush}" CornerRadius="4">
                                <TextBlock x:Name="InteractionHotkeyText" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="{StaticResource TextSm}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource TextSm}"
                                       Text="Pass-through: clicks fall to the game" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextXs}" LineHeight="17"
                                   Text="Panels stay on screen but stop catching the mouse, so you can read a wiki page while you play. Press it again to interact with them." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Padding="7,2" Background="{StaticResource AccentPillBrush}" CornerRadius="4">
                                <TextBlock x:Name="VisibilityHotkeyText" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="{StaticResource TextSm}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource TextSm}"
                                       Text="Hide and restore the whole overlay" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextXs}" LineHeight="17"
                                   Text="Everything disappears and comes back exactly where it was. A tray icon brings it back too." />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           FontSize="{StaticResource TextXs}"
                           Text="Both shortcuts can be changed later under Settings." />
            </StackPanel>

            <StackPanel x:Name="StepThree" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="{StaticResource TextSm}"
                           Text="Panels are created from the dock, and the arrangement you end up with is saved as a layout automatically. Give layouts names and DriftDeck can load the right one on its own when you switch games." />

                <CheckBox x:Name="CreateBrowserCheckBox" Margin="0,18,0,0" IsChecked="True"
                          Content="Start me off with a browser panel" />
                <CheckBox x:Name="CreateNotesCheckBox" Margin="0,10,0,0" IsChecked="True"
                          Content="Start me off with a notes panel" />
                <CheckBox x:Name="AutoSwitchCheckBox" Margin="0,10,0,0"
                          Content="Switch layouts automatically per application (set up rules in Settings)" />

                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           FontSize="{StaticResource TextXs}" LineHeight="17"
                           Text="Every panel has its own opacity and zoom in its title bar. Ctrl+B adds a browser panel, Ctrl+N adds notes, and Ctrl+Shift+T reopens the last one you closed." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="Skip" Width="80"
                    HorizontalAlignment="Left" Click="SkipButton_OnClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="Back" Width="90"
                        IsEnabled="False" Click="BackButton_OnClick" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next" Width="120"
                        Margin="8,0,0,0" IsDefault="True" Click="NextButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
