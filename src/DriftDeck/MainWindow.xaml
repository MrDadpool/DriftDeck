<Window x:Class="DriftDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriftDeck"
        Width="640" Height="104" MinWidth="600" MinHeight="30" MaxHeight="104"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource BodyFont}"
        Topmost="True" ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="DockRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition x:Name="StatusRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Title strip ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ConsoleHeaderBrush}" CornerRadius="7,7,0,0"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="10,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DRIFTDECK" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="{StaticResource TextMd}"
                               VerticalAlignment="Center" />
                    <!-- The only accent in this strip: it reports a mode the user can change. -->
                    <Border x:Name="ModePill" Margin="8,0,0,0" Padding="6,1"
                            Background="{DynamicResource AccentPillBrush}" CornerRadius="7">
                        <TextBlock x:Name="ModeText" Text="Interactive" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="{StaticResource TextXs}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Settings" Height="26"
                            FontSize="{StaticResource TextXs}" Padding="10,0" Click="SettingsButton_OnClick" />
                    <Button x:Name="CollapseButton" AutomationProperties.AutomationId="CollapseDockButton"
                            Style="{StaticResource TitleIconButton}" Content="&#xE921;" Margin="4,0,0,0"
                            Click="MinimizeButton_OnClick"
                            ToolTip="Collapse the dock to the bottom-right of this monitor" />
                    <Button Style="{StaticResource TitleIconButton}" Content="&#xE8BB;" Margin="2,0,0,0"
                            Click="CloseButton_OnClick" ToolTip="Quit DriftDeck and close every panel" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Routine actions stay in the dock; occasional setup lives in the menu. -->
        <Border x:Name="DockToolbar" Grid.Row="1" Background="{DynamicResource SurfaceBaseBrush}" Padding="14,9">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AccentButton}" Content="Add panel" Padding="14,0"
                        Click="MenuButton_OnClick" AutomationProperties.Name="Add panel">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AddPanelMenu">
                            <MenuItem Header="Web page" InputGestureText="Ctrl+B" Click="AddBrowserButton_OnClick" />
                            <MenuItem Header="Notes" InputGestureText="Ctrl+N" Click="AddNotesButton_OnClick" />
                            <MenuItem Header="Checklist" InputGestureText="Ctrl+K" Click="AddChecklistButton_OnClick" />
                            <MenuItem Header="Timer" InputGestureText="Ctrl+T" Click="AddTimerButton_OnClick" />
                            <MenuItem Header="Image" InputGestureText="Ctrl+I" Click="AddImageButton_OnClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ComboBox x:Name="LayoutComboBox" Grid.Column="1" Margin="12,0" MaxWidth="260"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Current layout"
                          SelectionChanged="LayoutComboBox_OnSelectionChanged"
                          ToolTip="Choose a layout. Your changes are saved automatically." />
                <Button x:Name="PassThroughButton" Grid.Column="2" Content="Pass through"
                        Click="InteractionButton_OnClick" />
                <Button Grid.Column="3" Content="More" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Click="MenuButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu">
                            <MenuItem Header="Save layout as" Click="SaveLayoutButton_OnClick" />
                            <MenuItem Header="Duplicate layout" Click="CopyLayoutButton_OnClick" />
                            <MenuItem x:Name="DeleteButton" Header="Delete layout" StaysOpenOnClick="True" Click="DeleteLayoutButton_OnClick" />
                            <Separator />
                            <MenuItem x:Name="ReopenButton" Header="Reopen closed panel" IsEnabled="False"
                                      InputGestureText="Ctrl+Shift+T" Click="ReopenPanelButton_OnClick" />
                            <MenuItem x:Name="GatherButton" Header="Bring panels to this monitor"
                                      AutomationProperties.AutomationId="GatherPanelsButton" Click="GatherButton_OnClick" />
                            <MenuItem x:Name="MuteAllButton" Header="Mute all browsers"
                                      AutomationProperties.AutomationId="MuteAllButton" Click="MuteAllButton_OnClick" />
                            <Separator />
                            <MenuItem StaysOpenOnClick="True" Focusable="False">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Fade panels" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Slider x:Name="OverlayTransparencySlider" Width="100" Minimum="0" Maximum="65" Value="2"
                                                AutomationProperties.AutomationId="OverlayTransparencySlider"
                                                AutomationProperties.Name="Panel transparency"
                                                ValueChanged="OverlayTransparencySlider_OnValueChanged" />
                                        <TextBlock x:Name="TransparencyValueText" Text="2%" Width="36"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ================= Status strip ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceStatusBrush}" CornerRadius="0,0,7,7"
                Padding="14,0" Height="24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid x:Name="StatusPanel" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Grid.Column="1" Margin="8,0,12,0" Foreground="{DynamicResource MutedBrush}"
                               FontSize="{StaticResource TextXs}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock x:Name="SaveStateText" Grid.Column="1" Text="Changes save automatically"
                           Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource TextXs}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Control Grid.RowSpan="3" Style="{StaticResource FrameArtLayer}" />

        <!-- Shown while pass-through is active, so the dock reads as inert. -->
        <Border x:Name="PassThroughScrim" Grid.RowSpan="3" CornerRadius="{DynamicResource FrameRadius}"
                IsHitTestVisible="False" Background="{DynamicResource ScrimBrush}"
                BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" Opacity="0" />
    </Grid>
</Window>
