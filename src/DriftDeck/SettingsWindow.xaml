<Window x:Class="DriftDeck.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DriftDeck.Models"
        Title="DriftDeck Settings" Width="660" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource SurfaceBaseBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="{StaticResource TextXl}" FontWeight="Bold" />
            <TextBlock Text="These shortcuts work everywhere while DriftDeck is running, including inside a game."
                       Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                       FontSize="{StaticResource TextSm}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- ================= Shortcuts ================= -->
                <Grid Margin="0,26,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pass-through toggle" VerticalAlignment="Center" FontSize="{StaticResource TextSm}" />
                    <TextBox x:Name="InteractionHotkeyBox" Grid.Column="1" IsReadOnly="True" Cursor="Hand"
                             PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" GotKeyboardFocus="HotkeyBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="HotkeyBox_OnLostKeyboardFocus"
                             ToolTip="Click, then press the shortcut you want" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Reset" Width="72" Margin="8,0,0,0"
                            Tag="Interaction" Click="ResetHotkeyButton_OnClick" />

                    <TextBlock Grid.Row="1" Text="Hide / restore overlay" VerticalAlignment="Center" Margin="0,12,0,0"
                               FontSize="{StaticResource TextSm}" />
                    <TextBox x:Name="VisibilityHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" IsReadOnly="True"
                             Cursor="Hand" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                             GotKeyboardFocus="HotkeyBox_OnGotKeyboardFocus" LostKeyboardFocus="HotkeyBox_OnLostKeyboardFocus"
                             ToolTip="Click, then press the shortcut you want" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Reset" Width="72"
                            Margin="8,12,0,0" Tag="Visibility" Click="ResetHotkeyButton_OnClick" />
                </Grid>

                <StackPanel Margin="0,18,0,0">
                    <TextBlock x:Name="HintText" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource TextXs}"
                               TextWrapping="Wrap"
                               Text="Click a shortcut box and press the keys. Windows-reserved combinations are refused." />
                    <TextBlock x:Name="ValidationText" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"
                               FontSize="{StaticResource TextXs}" TextWrapping="Wrap" />
                    <CheckBox x:Name="StartHiddenCheckBox" Margin="0,18,0,0"
                              Content="Start with the overlay hidden — a tray icon brings it back" />
                </StackPanel>

                <!-- ================= Per-application layouts ================= -->
                <Border Margin="0,22,0,0" Padding="16,14" Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel>
                        <TextBlock Text="PER-APPLICATION LAYOUTS" Style="{StaticResource GroupLabel}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <CheckBox x:Name="AutoSwitchCheckBox" Margin="0,10,0,0"
                                  Content="Load a layout automatically when I switch to a matching application" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextXs}" LineHeight="17"
                                   Text="DriftDeck reads only the name and window title of whichever window is in front, the same information the taskbar shows. Loading a layout by hand pauses switching until you move to a different application." />

                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="APPLICATION" Style="{StaticResource GroupLabel}" />
                            <TextBlock Grid.Column="2" Text="TITLE CONTAINS" Style="{StaticResource GroupLabel}" />
                            <TextBlock Grid.Column="3" Text="LAYOUT" Style="{StaticResource GroupLabel}" />
                        </Grid>

                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LayoutRule}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                  ToolTip="Turn this rule off without deleting it" />
                                        <TextBox Grid.Column="1" Margin="0,0,6,0"
                                                 Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Executable name without .exe, for example eldenring" />
                                        <TextBox Grid.Column="2" Margin="0,0,6,0"
                                                 Text="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Optional. Leave empty to match any window of that application" />
                                        <ComboBox Grid.Column="3" IsEditable="True"
                                                  ItemsSource="{Binding LayoutNames,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding LayoutName, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Layout to load when this rule matches" />
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                Margin="6,0,0,0" Click="RemoveRuleButton_OnClick"
                                                ToolTip="Remove this rule" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoRulesText" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextXs}"
                                   Text="No rules yet. Add one, or capture the application you are about to switch to." />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Add rule" Width="100"
                                    Click="AddRuleButton_OnClick" />
                            <Button x:Name="CaptureRuleButton" Style="{StaticResource GhostButton}" Width="210"
                                    Margin="6,0,0,0" Content="Capture the next app I switch to"
                                    Click="CaptureRuleButton_OnClick"
                                    ToolTip="Click, then click the application you want a rule for. It is captured after 4 seconds." />
                            <TextBlock x:Name="CaptureStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource TextXs}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= Updates ================= -->
                <Border Margin="0,16,0,0" Padding="16,14" Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel>
                        <TextBlock Text="UPDATES" Style="{StaticResource GroupLabel}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <CheckBox x:Name="CheckForUpdatesCheckBox" Margin="0,10,0,0"
                                  Content="Check GitHub for a newer release when DriftDeck starts" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextXs}" LineHeight="17"
                                   Text="An anonymous request for the public release list. Nothing about you or the applications you run is sent, and nothing installs itself: DriftDeck ships as a portable folder, so an update means downloading the new one." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CheckNowButton" Style="{StaticResource GhostButton}" Content="Check now"
                                    Width="110" Click="CheckNowButton_OnClick" />
                            <Button Style="{StaticResource GhostButton}" Content="Open releases" Width="130"
                                    Margin="6,0,0,0" Click="OpenReleasesButton_OnClick" />
                            <Button Style="{StaticResource GhostButton}" Content="Open log folder" Width="140"
                                    Margin="6,0,0,0" Click="OpenLogsButton_OnClick"
                                    ToolTip="Crash reports are written here and never sent anywhere" />
                            <TextBlock x:Name="UpdateStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource TextXs}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= Safety ================= -->
                <Border Margin="0,16,0,0" Padding="16,14" Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel>
                        <TextBlock Text="SAFETY BOUNDARY" Style="{StaticResource GroupLabel}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="19" FontSize="{StaticResource TextSm}"
                                   Text="DriftDeck is an ordinary standalone desktop window. It never reads game memory or files, injects code, hooks rendering, automates input, extracts telemetry, or interacts with anti-cheat software. Per-application layouts use only the foreground window's process name and title, which Windows publishes to every desktop application." />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="{StaticResource TextSm}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Borderless-windowed mode is recommended. Exclusive fullscreen may prevent desktop overlays from appearing." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Width="96" IsCancel="True"
                    Click="CancelButton_OnClick" />
            <Button Style="{StaticResource AccentButton}" Content="Save settings" Width="140" Margin="8,0,0,0"
                    IsDefault="True" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
