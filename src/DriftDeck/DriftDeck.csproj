<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced solely for NotifyIcon; WPF has no tray-icon primitive. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DriftDeck</AssemblyName>
    <Version>0.3.0</Version>
    <RootNamespace>DriftDeck</RootNamespace>
    <!-- App.Main runs Velopack's install/update hooks before WPF starts; see App.xaml.cs. -->
    <StartupObject>DriftDeck.App</StartupObject>
    <Authors>DriftDeck contributors</Authors>
    <Copyright>Copyright (c) 2026 DriftDeck contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms implicit usings collide with WPF (Application, Point, KeyEventArgs, ...).
         TrayIconService imports what it needs explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Keep in step with the vpk version in .github/workflows/build.yml and Build-Installer.ps1. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
</Project>
