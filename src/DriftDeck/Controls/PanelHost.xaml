<UserControl x:Class="DriftDeck.Controls.PanelHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Segoe UI"
             MinWidth="360" MinHeight="200">
    <Border x:Name="OuterBorder" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
            CornerRadius="{StaticResource FrameRadius}" Background="{StaticResource SurfaceBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition x:Name="ToolbarRow" Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title strip ================= -->
            <Border x:Name="DragSurface" Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="DragSurface_OnMouseLeftButtonUp"
                    MouseMove="DragSurface_OnMouseMove">
                <Grid Margin="7,0,3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Neutral until the panel is the active one; accent means state, not decoration. -->
                    <Rectangle x:Name="KindStripe" Width="2" Height="9" Fill="{StaticResource StrokeSubtleBrush}"
                               RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />

                    <Grid Grid.Column="1" Margin="7,0,6,0">
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="{StaticResource TextXs}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="Double-click to rename this panel"
                                   MouseLeftButtonDown="TitleText_OnMouseLeftButtonDown" />
                        <TextBox x:Name="TitleEditBox" Visibility="Collapsed" Height="16"
                                 FontSize="{StaticResource TextXs}" Padding="4,0"
                                 KeyDown="TitleEditBox_OnKeyDown" LostFocus="TitleEditBox_OnLostFocus" />
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource TitleIconButton}" Width="18" Content="&#xE738;"
                            Click="ZoomOutButton_OnClick" ToolTip="Smaller content (Ctrl+-)" />
                    <TextBlock x:Name="ContentScaleText" Grid.Column="3" Text="100%" Width="32" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               FontSize="{StaticResource TextXs}" Cursor="Hand"
                               ToolTip="Content scale. Click to reset to 100%."
                               MouseLeftButtonDown="ContentScaleText_OnMouseLeftButtonDown" />
                    <Button Grid.Column="4" Style="{StaticResource TitleIconButton}" Width="18" Content="&#xE710;"
                            Click="ZoomInButton_OnClick" ToolTip="Larger content (Ctrl++)" />

                    <Slider x:Name="OpacitySlider" Grid.Column="5" Width="56" Height="16" Margin="7,0,3,0"
                            Minimum="0.35" Maximum="1" ValueChanged="OpacitySlider_OnValueChanged"
                            AutomationProperties.AutomationId="PanelOpacitySlider"
                            AutomationProperties.Name="Panel opacity"
                            ToolTip="Opacity for this panel only" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DuplicateButton" Style="{StaticResource TitleIconButton}" Width="18"
                                AutomationProperties.AutomationId="PanelDuplicateButton"
                                Content="&#xE8C8;" Click="DuplicateButton_OnClick"
                                ToolTip="Duplicate this panel (Ctrl+D)" />
                        <Button x:Name="LockButton" Style="{StaticResource TitleIconButton}" Width="18"
                                AutomationProperties.AutomationId="PanelLockButton"
                                Content="&#xE785;" Click="LockButton_OnClick"
                                ToolTip="Lock this panel in place (Ctrl+Shift+L)" />
                        <Button x:Name="ShadeButton" Style="{StaticResource TitleIconButton}" Width="18"
                                AutomationProperties.AutomationId="PanelShadeButton"
                                Content="&#xE70E;" Click="ShadeButton_OnClick"
                                ToolTip="Roll up to the title bar (Ctrl+M)" />
                        <Button Style="{StaticResource TitleIconButton}" Width="18" Content="&#xE8BB;"
                                Click="CloseButton_OnClick" ToolTip="Close this panel (Ctrl+W)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Browser toolbar ================= -->
            <Grid x:Name="BrowserToolbar" Grid.Row="1" Margin="6,6,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            IsEnabled="False" Click="BackButton_OnClick" ToolTip="Back (Alt+Left)" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;"
                            IsEnabled="False" Margin="3,0,0,0" Click="ForwardButton_OnClick"
                            ToolTip="Forward (Alt+Right)" />
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Margin="3,0,0,0" Click="ReloadButton_OnClick" ToolTip="Reload (Ctrl+R)" />
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                            Margin="3,0,0,0" Click="MuteButton_OnClick"
                            AutomationProperties.AutomationId="PanelMuteButton"
                            ToolTip="Mute this panel's audio (Ctrl+Shift+M)" />
                </StackPanel>

                <TextBox x:Name="AddressBox" Grid.Column="1" KeyDown="AddressBox_OnKeyDown"
                         GotKeyboardFocus="AddressBox_OnGotKeyboardFocus" ToolTip="Address (Ctrl+L)" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Go" Width="42" Click="GoButton_OnClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="3,0,0,0"
                            Click="OpenExternalButton_OnClick"
                            ToolTip="Open this address in the default browser" />
                </StackPanel>
            </Grid>

            <!-- Indeterminate load sweep, sitting on the seam between toolbar and content. -->
            <Border x:Name="LoadingBar" Grid.Row="1" Height="2" VerticalAlignment="Bottom" Margin="6,0,6,-2"
                    Background="{StaticResource AccentBrush}" Opacity="0" ClipToBounds="True"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LoadingScale" ScaleX="0" />
                </Border.RenderTransform>
            </Border>

            <!-- ================= Content ================= -->
            <Grid x:Name="ContentArea" Grid.Row="2" Margin="6,6,6,6">
                <Border x:Name="BrowserSurface" Background="{StaticResource SurfaceDeepBrush}"
                        CornerRadius="{StaticResource ControlRadius}" ClipToBounds="True">
                    <Grid>
                        <!-- DefaultBackgroundColor is a GDI colour, not a brush, so it is set
                             from the SurfaceDeep token in code rather than inlined here. -->
                        <wv2:WebView2CompositionControl x:Name="Browser" />
                        <StackPanel x:Name="BrowserError" Visibility="Collapsed" Margin="30"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="BrowserErrorTitle" TextAlignment="Center"
                                       FontSize="{StaticResource TextLg}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="BrowserErrorDetail" TextAlignment="Center" Margin="0,10,0,0"
                                       FontSize="{StaticResource TextSm}" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="BrowserErrorRetry" Content="Try again" HorizontalAlignment="Center"
                                    Margin="0,18,0,0" Width="112" Click="ReloadButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- No border of its own: the panel frame already provides containment. -->
                <Border x:Name="NotesSurface" Visibility="Collapsed" Background="{StaticResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource ControlRadius}">
                    <Grid>
                        <TextBlock x:Name="NotesPlaceholder" Text="Type notes here. They save automatically."
                                   Margin="13,11,0,0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextMd}" IsHitTestVisible="False"
                                   VerticalAlignment="Top" />
                        <TextBox x:Name="NotesBox" Style="{StaticResource NotesTextBox}" AcceptsReturn="True"
                                 AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="NotesBox_OnTextChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Decorative only: the window itself owns resizing on every edge. -->
            <Path x:Name="ResizeHint" Grid.Row="2" Width="14" Height="14" Margin="0,0,3,3" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.5"
                  Data="M 3,13 L 13,3 M 8,13 L 13,8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1" />
        </Grid>
    </Border>
</UserControl>
