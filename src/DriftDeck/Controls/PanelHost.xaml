<UserControl x:Class="DriftDeck.Controls.PanelHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Segoe UI"
             MinWidth="420" MinHeight="200">
    <UserControl.Resources>
        <!-- One checklist row. It binds straight to the persisted ChecklistItem, so ticking a
             box or editing text updates what gets saved without a copy in between. -->
        <DataTemplate x:Key="ChecklistItemTemplate">
            <Grid x:Name="Row" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center"
                          AutomationProperties.Name="Done" />

                <!-- The implicit TextBox style sets FontSize, which would block the content scale
                     ApplyContentScale puts on the list. -->
                <TextBox x:Name="ItemText" Grid.Column="1" Margin="6,0,0,0"
                         FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200" Background="Transparent" BorderThickness="0"
                         Padding="2,3" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}"
                         KeyDown="ChecklistItemBox_OnKeyDown" />

                <!-- Hidden until the row is pointed at: a delete on every line reads as clutter
                     on a list whose usual action is ticking a box. -->
                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource TitleIconButton}"
                        Width="24" Content="&#xE711;" Opacity="0" Focusable="False"
                        Click="ChecklistRemoveButton_OnClick" ToolTip="Remove this item" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <Trigger SourceName="ItemText" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="OuterBorder" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
            CornerRadius="{StaticResource FrameRadius}" Background="{StaticResource SurfaceBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition x:Name="ToolbarRow" Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title strip ================= -->
            <Border x:Name="DragSurface" Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="DragSurface_OnMouseLeftButtonUp"
                    MouseMove="DragSurface_OnMouseMove">
                <Grid Margin="7,0,3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Neutral until the panel is the active one; accent means state, not decoration. -->
                    <Rectangle x:Name="KindStripe" Width="3" Height="14" Fill="{StaticResource StrokeSubtleBrush}"
                               RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />

                    <Grid Grid.Column="1" Margin="7,0,6,0">
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="{StaticResource TextXs}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="Double-click to rename this panel"
                                   MouseLeftButtonDown="TitleText_OnMouseLeftButtonDown" />
                        <TextBox x:Name="TitleEditBox" Visibility="Collapsed" Height="26"
                                 FontSize="{StaticResource TextXs}" Padding="4,0"
                                 KeyDown="TitleEditBox_OnKeyDown" LostFocus="TitleEditBox_OnLostFocus" />
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource TitleIconButton}" Width="24" Content="&#xE738;"
                            Click="ZoomOutButton_OnClick" ToolTip="Smaller content (Ctrl+-)" />
                    <TextBlock x:Name="ContentScaleText" Grid.Column="3" Text="100%" Width="32" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               FontSize="{StaticResource TextXs}" Cursor="Hand"
                               ToolTip="Content scale. Click to reset to 100%."
                               MouseLeftButtonDown="ContentScaleText_OnMouseLeftButtonDown" />
                    <Button Grid.Column="4" Style="{StaticResource TitleIconButton}" Width="24" Content="&#xE710;"
                            Click="ZoomInButton_OnClick" ToolTip="Larger content (Ctrl++)" />

                    <Slider x:Name="OpacitySlider" Grid.Column="5" Width="56" Height="26" Margin="7,0,3,0"
                            Minimum="0.35" Maximum="1" ValueChanged="OpacitySlider_OnValueChanged"
                            AutomationProperties.AutomationId="PanelOpacitySlider"
                            AutomationProperties.Name="Panel opacity"
                            ToolTip="Opacity for this panel only" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyNotesButton" Style="{StaticResource TitleIconButton}" Width="24"
                                AutomationProperties.AutomationId="PanelCopyNotesButton"
                                Visibility="Collapsed" Content="&#xF0E3;" Click="CopyNotesButton_OnClick"
                                ToolTip="Copy these notes to the clipboard (Ctrl+Shift+C)" />
                        <Button x:Name="DuplicateButton" Style="{StaticResource TitleIconButton}" Width="24"
                                AutomationProperties.AutomationId="PanelDuplicateButton"
                                Content="&#xE8C8;" Click="DuplicateButton_OnClick"
                                ToolTip="Duplicate this panel (Ctrl+D)" />
                        <Button x:Name="LockButton" Style="{StaticResource TitleIconButton}" Width="24"
                                AutomationProperties.AutomationId="PanelLockButton"
                                Content="&#xE785;" Click="LockButton_OnClick"
                                ToolTip="Lock this panel in place (Ctrl+Shift+L)" />
                        <Button x:Name="ShadeButton" Style="{StaticResource TitleIconButton}" Width="24"
                                AutomationProperties.AutomationId="PanelShadeButton"
                                Content="&#xE70E;" Click="ShadeButton_OnClick"
                                ToolTip="Roll up to the title bar (Ctrl+M)" />
                        <Button Style="{StaticResource TitleIconButton}" Width="24" Content="&#xE8BB;"
                                Click="CloseButton_OnClick" ToolTip="Close this panel (Ctrl+W)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Browser toolbar ================= -->
            <Grid x:Name="BrowserToolbar" Grid.Row="1" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            IsEnabled="False" Click="BackButton_OnClick" ToolTip="Back (Alt+Left)" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;"
                            IsEnabled="False" Margin="3,0,0,0" Click="ForwardButton_OnClick"
                            ToolTip="Forward (Alt+Right)" />
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Margin="3,0,0,0" Click="ReloadButton_OnClick" ToolTip="Reload (Ctrl+R)" />
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                            Margin="3,0,0,0" Click="MuteButton_OnClick"
                            AutomationProperties.AutomationId="PanelMuteButton"
                            ToolTip="Mute this panel's audio (Ctrl+Shift+M)" />
                </StackPanel>

                <TextBox x:Name="AddressBox" Grid.Column="1" AutomationProperties.Name="Web address" KeyDown="AddressBox_OnKeyDown"
                         GotKeyboardFocus="AddressBox_OnGotKeyboardFocus" ToolTip="Address (Ctrl+L)" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="SuggestionsButton" Style="{StaticResource IconButton}" Content="&#xE70D;"
                            Margin="0,0,3,0" Click="SuggestionsButton_OnClick"
                            AutomationProperties.AutomationId="PanelSuggestionsButton"
                            ToolTip="Bookmarks and recent addresses" />
                    <Button Style="{StaticResource GhostButton}" Content="Go" Width="42" Click="GoButton_OnClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="3,0,0,0"
                            Click="OpenExternalButton_OnClick"
                            ToolTip="Open this address in the default browser" />
                </StackPanel>
            </Grid>

            <!-- Indeterminate load sweep, sitting on the seam between toolbar and content. -->
            <Border x:Name="LoadingBar" Grid.Row="1" Height="2" VerticalAlignment="Bottom" Margin="6,0,6,-2"
                    Background="{StaticResource AccentBrush}" Opacity="0" ClipToBounds="True"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LoadingScale" ScaleX="0" />
                </Border.RenderTransform>
            </Border>

            <!-- ================= Content ================= -->
            <Grid x:Name="ContentArea" Grid.Row="2" Margin="6,6,6,6">
                <Border x:Name="BrowserSurface" Background="{StaticResource SurfaceDeepBrush}"
                        CornerRadius="{StaticResource ControlRadius}" ClipToBounds="True">
                    <Grid>
                        <!-- DefaultBackgroundColor is a GDI colour, not a brush, so it is set
                             from the SurfaceDeep token in code rather than inlined here. -->
                        <wv2:WebView2CompositionControl x:Name="Browser" />
                        <StackPanel x:Name="BrowserError" Visibility="Collapsed" Margin="30"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="BrowserErrorTitle" TextAlignment="Center"
                                       FontSize="{StaticResource TextLg}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="BrowserErrorDetail" TextAlignment="Center" Margin="0,10,0,0"
                                       FontSize="{StaticResource TextSm}" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="BrowserErrorRetry" Content="Try again" HorizontalAlignment="Center"
                                    Margin="0,18,0,0" Width="112" Click="ReloadButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= Bookmarks and recents =================
                     An overlay inside the panel, not a WPF Popup: a Popup is its own window,
                     and every DriftDeck window is topmost, which is exactly the case where
                     popup ordering goes wrong. Staying inside the panel also means the
                     pass-through scrim and the panel's own opacity apply to it unchanged. -->
                <Border x:Name="SuggestionsSurface" Visibility="Collapsed" VerticalAlignment="Top"
                        PreviewKeyDown="SuggestionsSurface_OnPreviewKeyDown"
                        MaxHeight="260" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <StackPanel Margin="8,7,8,8">
                            <Grid>
                                <TextBlock Text="Bookmarks" Style="{StaticResource GroupLabel}" />
                                <Button x:Name="AddBookmarkButton" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Right" Content="Add this page"
                                        AutomationProperties.AutomationId="PanelAddBookmarkButton"
                                        Click="AddBookmarkButton_OnClick" />
                            </Grid>

                            <TextBlock x:Name="NoBookmarksText" Text="Nothing saved yet."
                                       Margin="2,4,0,2" Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource TextSm}" />
                            <ItemsControl x:Name="BookmarkList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{Binding Label}" ToolTip="{Binding Url}"
                                                    Click="BookmarkItem_OnClick" />
                                            <Button Grid.Column="1" Style="{StaticResource TitleIconButton}"
                                                    Width="24" Content="&#xE8BB;" VerticalAlignment="Center"
                                                    Click="RemoveBookmarkButton_OnClick"
                                                    ToolTip="Remove this bookmark" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Recent in this layout" Style="{StaticResource GroupLabel}"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="NoRecentsText" Text="No pages opened here yet."
                                       Margin="2,4,0,2" Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource TextSm}" />
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left"
                                                Content="{Binding Label}" ToolTip="{Binding Url}"
                                                Click="RecentItem_OnClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- No border of its own: the panel frame already provides containment. -->
                <Border x:Name="NotesSurface" Visibility="Collapsed" Background="{StaticResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource ControlRadius}">
                    <Grid>
                        <TextBlock x:Name="NotesPlaceholder" Text="Type notes here. They save automatically."
                                   Margin="17,15,0,0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="{StaticResource TextMd}" IsHitTestVisible="False"
                                   VerticalAlignment="Top" />
                        <TextBox x:Name="NotesBox" AutomationProperties.Name="Panel notes" Style="{StaticResource NotesTextBox}" AcceptsReturn="True"
                                 AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="NotesBox_OnTextChanged" />
                    </Grid>
                </Border>

                <!-- Same sunken surface as notes: both are places the user writes into. -->
                <Border x:Name="ChecklistSurface" Visibility="Collapsed"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource ControlRadius}">
                    <Grid Margin="8,7,6,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ChecklistItems"
                                          ItemTemplate="{StaticResource ChecklistItemTemplate}" />
                        </ScrollViewer>

                        <!-- The add box sits under the list, so a new item appears where the
                             cursor already is rather than jumping to the top. -->
                        <TextBox x:Name="ChecklistAddBox" Grid.Row="1" Margin="0,6,0,0" MaxLength="200"
                                 MinHeight="{StaticResource ControlHeight}"
                                 AutomationProperties.Name="Add a checklist item"
                                 KeyDown="ChecklistAddBox_OnKeyDown"
                                 ToolTip="Type an item and press Enter" />

                        <Grid Grid.Row="2" Margin="2,6,0,0">
                            <TextBlock x:Name="ChecklistSummary" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource TextXs}" />
                            <Button x:Name="ChecklistClearDone" Style="{StaticResource GhostButton}"
                                    Content="Clear done" Height="24" Padding="8,0"
                                    FontSize="{StaticResource TextXs}" HorizontalAlignment="Right"
                                    Visibility="Collapsed" Click="ChecklistClearDone_OnClick"
                                    ToolTip="Remove every ticked item" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="TimerSurface" Visibility="Collapsed"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource ControlRadius}">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The readout is deliberately outside the five-step type scale. It is
                             the one thing a timer panel exists to show, and it has to be
                             readable at a glance from across a desk. Its size is set in code so
                             it tracks the panel's content scale. -->
                        <TextBlock x:Name="TimerReadout" Text="5:00" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   AutomationProperties.Name="Time remaining" />

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TimerDurationBox" Text="5:00" MaxLength="8"
                                     AutomationProperties.Name="Timer length"
                                     KeyDown="TimerDurationBox_OnKeyDown"
                                     LostFocus="TimerDurationBox_OnLostFocus"
                                     ToolTip="Length. A plain number is minutes; 90 or 1:30:00 both work." />
                            <Button x:Name="TimerStartButton" Grid.Column="1" Margin="6,0,0,0" Width="66"
                                    Content="Start" Click="TimerStartButton_OnClick"
                                    ToolTip="Start or pause the timer" />
                            <Button x:Name="TimerResetButton" Grid.Column="2" Margin="4,0,0,0"
                                    Style="{StaticResource GhostButton}" Content="Reset"
                                    Click="TimerResetButton_OnClick"
                                    ToolTip="Back to the full length" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Deep rather than sunken: this surface is a backdrop for a picture, not a
                     field the user writes into. -->
                <Border x:Name="ImageSurface" Visibility="Collapsed" AllowDrop="True"
                        Background="{StaticResource SurfaceDeepBrush}"
                        CornerRadius="{StaticResource ControlRadius}" ClipToBounds="True"
                        DragOver="ImageSurface_OnDragOver" Drop="ImageSurface_OnDrop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panning falls out of the scroll viewer, so zooming past the panel
                             edge needs no drag handling of its own. -->
                        <ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImageView" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>

                        <StackPanel x:Name="ImageEmptyState" Margin="24" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ImageEmptyTitle" Text="Drop an image here"
                                       TextAlignment="Center" FontSize="{StaticResource TextLg}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ImageEmptyDetail" Margin="0,8,0,0" TextAlignment="Center"
                                       Text="Or paste one with Ctrl+V, or choose a file."
                                       FontSize="{StaticResource TextSm}"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <Button Content="Choose image" HorizontalAlignment="Center" Margin="0,16,0,0"
                                    Width="128" Click="ImageChooseButton_OnClick" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ImageCaption" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource TextXs}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="ImageReplaceButton" Grid.Column="1"
                                    Style="{StaticResource GhostButton}" Content="Replace" Height="24"
                                    Padding="8,0" FontSize="{StaticResource TextXs}"
                                    Visibility="Collapsed" Click="ImageChooseButton_OnClick"
                                    ToolTip="Point this panel at a different image" />
                            <Button x:Name="ImageOpenButton" Grid.Column="2" Margin="4,0,0,0"
                                    Style="{StaticResource GhostButton}" Content="Open" Height="24"
                                    Padding="8,0" FontSize="{StaticResource TextXs}"
                                    Visibility="Collapsed" Click="ImageOpenButton_OnClick"
                                    ToolTip="Open this file in the default image viewer" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Decorative only: the window itself owns resizing on every edge. -->
            <Path x:Name="ResizeHint" Grid.Row="2" Width="14" Height="14" Margin="0,0,3,3" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.5"
                  Data="M 3,13 L 13,3 M 8,13 L 13,8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1" />
        </Grid>
    </Border>
</UserControl>
